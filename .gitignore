# JetBrains / WebStorm — share project settings; ignore machine-local churn.
# https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/shelf/
.idea/**/contentModel.xml
.idea/**/dataSources/
.idea/**/dataSources.ids
.idea/**/dataSources.local.xml
.idea/**/aws.xml
.vs/
node_modules/
.tmp/

# Claude Code — share CLAUDE.md; ignore machine-local settings.
.claude/settings.local.json

file*.rmmzsave
out/
coverage/

# Bun is the only package manager here, and bun.lock is the only lockfile that should exist.
# package-lock.json rode along from the pre-Bun era and sat tracked for three years; ignoring the
# other two means an absent-minded `npm install` cannot quietly commit a second source of truth.
package-lock.json
yarn.lock

# the save system writes real directories now rather than one .rmmzsave file, and a testplay run
# from the repo root leaves one behind. Anchored with a leading slash on purpose: a bare `save/`
# matches a directory of that name at *any* depth, which silently swallowed every test under
# test/plugins/_base/ext/save/.
/save/