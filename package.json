{
  "name": "plugin-dev-utilities",
  "type": "module",
  "license": "MIT",
  "author": "je-can-code",
  "devDependencies": {
    "@babel/plugin-syntax-import-assertions": "^7.22.5",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@vitest/coverage-istanbul": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "nodemon": "^3.0.1",
    "oxlint": "^1.79.0",
    "vite": "^8.0.13",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "async": "^3.2.4",
    "glob": "^10.3.3",
    "source-map": "^0.7.6"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-syntax-import-assertions"
    ]
  },
  "scripts": {
    "plugin:init": "node ./src/build-tools/init.js",
    "lint": "node ./src/build-tools/generate-oxlint-globals.js && oxlint src/plugins src/build-tools test",
    "generate:oxlint-globals": "node ./src/build-tools/generate-oxlint-globals.js",
    "verify:docs": "node ./src/build-tools/verify-docs.js",
    "verify:no-typeof": "node ./src/build-tools/verify-no-typeof.js",
    "verify:no-instanceof": "node ./src/build-tools/verify-no-instanceof.js",
    "verify:no-optional-chaining": "node ./src/build-tools/verify-no-optional-chaining.js",
    "verify:no-direct-property-getset": "node ./src/build-tools/verify-no-direct-property-getset.js",
    "verify:no-private-before-construction": "node ./src/build-tools/verify-no-private-before-construction.js",
    "verify:no-late-window-command-state": "node ./src/build-tools/verify-no-late-window-command-state.js",
    "verify:no-self-calling-accessors": "node ./src/build-tools/verify-no-self-calling-accessors.js",
    "verify:no-chained-call-arguments": "node ./src/build-tools/verify-no-chained-call-arguments.js",
    "verify:no-phantom-calls": "node ./src/build-tools/verify-no-phantom-calls.js",
    "verify:no-rest-parameters": "node ./src/build-tools/verify-no-rest-parameters.js",
    "verify:declared-dependencies": "node ./src/build-tools/verify-declared-dependencies.js",
    "verify:no-phantom-calls:selftest": "node ./src/build-tools/verify-no-phantom-calls.js --selftest",
    "test": "bun run build:all && vitest run",
    "test:verbose": "bun run build:all && vitest run --reporter=default --silent=false",
    "test:watch": "vitest --reporter=default",
    "test:coverage": "bun run build:all && vitest run --coverage",
    "test:coverage:ui": "bun run build:all && vitest run --coverage --coverage.reporter=html",
    "mutate": "node ./src/build-tools/mutate.js",
    "defs:generate": "node ./src/build-tools/generate-rmmz-engine-defs.js --clean",
    "verify-pre-compile": "bun run lint && bun run verify:docs && bun run verify:no-typeof && bun run verify:no-instanceof && bun run verify:no-optional-chaining && bun run verify:no-direct-property-getset && bun run verify:no-private-before-construction && bun run verify:no-late-window-command-state && bun run verify:no-self-calling-accessors && bun run verify:no-chained-call-arguments && bun run verify:no-phantom-calls && bun run verify:no-rest-parameters && bun run verify:declared-dependencies",
    "compile": "bun run clean:out && bun run build:all",
    "verify-post-compile": "bun run verify:ships && bun run test && bun run copy:to-all",
    "hotfix": "bun run verify-pre-compile && bun run compile && bun run verify-post-compile",
    "verify:ci": "bun run verify-pre-compile && bun run compile && bun run verify:ships && vitest run --coverage --coverage.reporter=text-summary",
    "verify:no-build-drift": "bun run copy:to-test && git diff --exit-code -- project/js/plugins",
    "verify:ships": "node ./src/build-tools/verify-ships.js",
    "migrate:sdp-keys": "node ./src/build-tools/migrate-sdp-parameter-keys.mjs",
    "migrate:sdp-mastery": "node ./src/build-tools/migrate-sdp-mastery-fields.mjs",
    "migrate:sdp-panel-shape": "node ./src/build-tools/migrate-sdp-panel-shape.mjs",
    "clean:out": "node ./src/build-tools/obliterator.js ./out",
    "copy:to-test": "node ./src/build-tools/copy.js",
    "copy:to-ca": "node ./src/build-tools/copy.js ../ca/chef-adventure/js/plugins/j",
    "copy:to-all": "node ./src/build-tools/copy.js ../ca/chef-adventure/js/plugins/j ./project/js/plugins",
    "build:all": "node ./src/build-tools/build-all.js"
  }
}
